{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "notchset-foundation",
  "type": "registry:item",
  "title": "Notchset foundation",
  "description": "The roles every component is built from (surfaces, ink, signal, type, space, sizes, radii, motion), read from the shadcn tokens. Installed once, by any component.",
  "css": {
    ":where(:root, .dark, .light, [data-theme])": {
      "--ns-canvas": "var(--background)",
      "--ns-side": "var(--sidebar, var(--background))",
      "--ns-panel": "var(--card)",
      "--ns-raised": "var(--popover)",
      "--ns-well": "var(--muted)",
      "--ns-hover": "var(--accent)",
      "--ns-selected": "color-mix(in oklab, var(--accent) 70%, var(--foreground) 3%)",
      "--ns-line": "var(--border)",
      "--ns-line-soft": "color-mix(in oklab, var(--border) 55%, var(--card))",
      "--ns-ink": "var(--foreground)",
      "--ns-ink-2": "var(--muted-foreground)",
      "--ns-ink-3": "color-mix(in oklab, var(--muted-foreground) 80%, var(--background))",
      "--ns-signal": "var(--ring)",
      "--ns-ok": "var(--success, #2f8f5f)",
      "--ns-warn": "var(--warning, #9a5a12)",
      "--ns-bad": "var(--destructive)",
      "--ns-bad-ink": "color-mix(in oklab, var(--ns-bad) var(--ns-tint-ink), var(--ns-ink))",
      "--ns-ok-ink": "color-mix(in oklab, var(--ns-ok) var(--ns-tint-ink), var(--ns-ink))",
      "--ns-tint": "10%",
      "--ns-range": "color-mix(in oklab, var(--ns-ink) 8%, transparent)",
      "--ns-stack-on": "var(--ns-panel)",
      "--ns-tint-ink": "62%",
      "--ns-series": "var(--chart-series, #6d5bd0)",
      "--ns-series-tint": "var(--chart-series-tint, 30%)",
      "--ns-series-lilac": "var(--chart-series-lilac, #c084fc)",
      "--ns-glow": "var(--chart-series-glow, 25%)",
      "--ns-pulse": "var(--ns-ok)",
      "--ns-orb-deep": "color-mix(in oklab, var(--ns-signal) 70%, black)",
      "--ns-orb-core": "var(--ns-signal)",
      "--ns-orb-body": "color-mix(in oklab, var(--ns-signal) 75%, white)",
      "--ns-orb-lift": "color-mix(in oklab, var(--ns-signal) 45%, white)",
      "--ns-orb-rim": "var(--ns-orb-lift)",
      "--ns-orb-cool": "color-mix(in oklab, var(--ns-signal) 35%, white)",
      "--ns-orb-warm": "color-mix(in oklab, var(--ns-signal) 30%, white)",
      "--ns-orb-dawn": "color-mix(in oklab, var(--ns-signal) 12%, white)",
      "--ns-orb-skin-hi": "color-mix(in oklab, var(--ns-signal) 15%, white)",
      "--ns-orb-skin-mid": "color-mix(in oklab, var(--ns-signal) 60%, white)",
      "--ns-orb-skin-lo": "color-mix(in oklab, var(--ns-signal) 85%, black)",
      "--ns-orb-inner": "transparent",
      "--ns-orb-limb": "color-mix(in oklab, var(--ns-signal) 30%, transparent)",
      "--ns-orb-limb-from": "46%",
      "--ns-orb-key": "1",
      "--ns-orb-edge": "color-mix(in oklab, var(--ns-ink) 14%, transparent)",
      "--ns-orb-grain": "0.34",
      "--ns-orb-halo": "color-mix(in oklab, var(--ns-signal) 30%, transparent)",
      "--ns-orb-ground": "color-mix(in oklab, var(--ns-signal) 22%, transparent)",
      "--ns-state-todo": "var(--ns-ink-3)",
      "--ns-state-doing": "var(--chart-state-doing, #d55181)",
      "--ns-state-review": "var(--chart-state-review, #2a78d6)",
      "--ns-state-done": "var(--chart-state-done, var(--ns-ok))",
      "--ns-heat": "var(--ns-state-done)",
      "--ns-cat-1": "var(--chart-cat-1, #2a78d6)",
      "--ns-cat-2": "var(--chart-cat-2, #eb6834)",
      "--ns-cat-3": "var(--chart-cat-3, #1baf7a)",
      "--ns-cat-4": "var(--chart-cat-4, #eda100)",
      "--ns-cat-5": "var(--chart-cat-5, #e87ba4)",
      "--ns-cat-6": "var(--chart-cat-6, #008300)",
      "--ns-bezel": "0 0 0 1px var(--border)",
      "--ns-lift": "0 0 0 1px var(--primary)",
      "--ns-shadow-float": "0 0 0 1px var(--border), 0 18px 40px -12px rgb(0 0 0 / 0.25)",
      "--ns-shadow-dialog": "0 0 0 1px var(--border), 0 30px 70px -20px rgb(0 0 0 / 0.4)",
      "--ns-shadow-panel": "0 0 0 1px var(--border), 0 24px 48px -28px rgb(0 0 0 / 0.3)"
    },
    ":where(:root)": {
      "--ns-toast-left": "24px",
      "--ns-toast-bottom": "calc(12px + env(safe-area-inset-bottom, 0px))",
      "--ns-font-body": "\"Inter\", ui-sans-serif, system-ui, sans-serif",
      "--ns-font-display": "\"Geist\", \"Inter\", ui-sans-serif, system-ui, sans-serif",
      "--ns-font-mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, monospace",
      "--ns-font-script": "\"Snell Roundhand\", \"Segoe Script\", \"Apple Chancery\", \"Brush Script MT\", cursive",
      "--ns-text-meta": "12px",
      "--ns-text-small": "12.5px",
      "--ns-text-body": "13px",
      "--ns-text-control": "13px",
      "--ns-text-strong": "14px",
      "--ns-text-sub": "16px",
      "--ns-text-title": "18px",
      "--ns-text-page": "22px",
      "--ns-text-figure": "26px",
      "--ns-text-hero": "32px",
      "--ns-text-lede": "18px",
      "--ns-text-headline": "clamp(28px, 1.25vw + 22px, 40px)",
      "--ns-text-display": "clamp(40px, 3.2vw + 26px, 72px)",
      "--ns-tracking-headline": "-0.035em",
      "--ns-weight-regular": "400",
      "--ns-weight-medium": "500",
      "--ns-weight-strong": "600",
      "--ns-leading": "1.45",
      "--ns-tracking-display": "-0.02em",
      "--ns-space-1": "4px",
      "--ns-space-2": "8px",
      "--ns-space-3": "12px",
      "--ns-space-4": "16px",
      "--ns-space-5": "20px",
      "--ns-space-6": "24px",
      "--ns-space-8": "32px",
      "--ns-gutter": "24px",
      "--ns-space-section": "clamp(72px, 6vw + 40px, 128px)",
      "--ns-control-sm": "28px",
      "--ns-control-pad": "12px",
      "--ns-control": "32px",
      "--ns-field": "32px",
      "--ns-segment": "26px",
      "--ns-chip": "26px",
      "--ns-row": "42px",
      "--ns-sheet-bottom": "8px",
      "--ns-row-compact": "34px",
      "--ns-header": "48px",
      "--ns-menu-row": "34px",
      "--ns-check": "16px",
      "--ns-switch-w": "36px",
      "--ns-switch-h": "22px",
      "--ns-touch": "40px",
      "--ns-panel-w": "420px",
      "--ns-dialog-sm": "420px",
      "--ns-dialog": "560px",
      "--ns-dialog-lg": "720px",
      "--ns-radius-sm": "6px",
      "--ns-radius": "var(--radius, 8px)",
      "--ns-radius-lg": "12px",
      "--ns-radius-xl": "16px",
      "--ns-radius-full": "999px",
      "--ns-ease": "cubic-bezier(0.22, 1, 0.36, 1)",
      "--ns-ease-in": "cubic-bezier(0.16, 1, 0.3, 1)",
      "--ns-ease-panel": "cubic-bezier(0.32, 0.72, 0, 1)",
      "--ns-ease-pop": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "--ns-time-color": "140ms",
      "--ns-time-menu": "160ms",
      "--ns-time-toast": "200ms",
      "--ns-time-dialog": "240ms",
      "--ns-time-panel": "260ms",
      "--ns-time-page": "320ms",
      "--ns-time-born": "1200ms",
      "--ns-menu-dy": "-4px"
    },
    "@media (pointer: coarse), (width < 960px)": {
      ":where(:root)": {
        "--ns-gutter": "16px",
        "--ns-control": "40px",
        "--ns-control-sm": "36px",
        "--ns-control-pad": "16px",
        "--ns-chip": "32px",
        "--ns-text-control": "14px",
        "--ns-field": "40px",
        "--ns-segment": "36px",
        "--ns-menu-row": "44px"
      }
    },
    "@media (width < 600px)": {
      ":where(:root)": {
        "--ns-row": "40px",
        "--ns-text-hero": "28px"
      }
    },
    "@keyframes ns-rise": {
      "from": {
        "opacity": "0",
        "transform": "translateY(5px)"
      }
    },
    "@keyframes ns-fade": {
      "from": {
        "opacity": "0"
      }
    },
    "@keyframes ns-island-in": {
      "from": {
        "opacity": "0",
        "filter": "blur(4px)"
      }
    },
    "@keyframes ns-ring-sweep": {
      "0%": {
        "box-shadow": "0 0 0 0 var(--ns-signal)"
      },
      "60%": {
        "box-shadow": "0 0 0 2px var(--ns-signal), 0 0 0 10px color-mix(in oklab, var(--ns-signal) 18%, transparent)"
      },
      "100%": {
        "box-shadow": "0 0 0 0 transparent"
      }
    },
    "@keyframes ns-ring-trace": {
      "from": {
        "stroke-dashoffset": "1",
        "opacity": "1"
      },
      "70%": {
        "stroke-dashoffset": "0",
        "opacity": "1"
      },
      "to": {
        "stroke-dashoffset": "0",
        "opacity": "0"
      }
    },
    "@keyframes ns-menu-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(var(--ns-menu-dy, -4px)) scale(0.97)"
      }
    },
    "@keyframes ns-dialog-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(8px) scale(0.985)"
      }
    },
    "@keyframes ns-panel-in": {
      "from": {
        "opacity": "0",
        "transform": "translateX(18px)"
      }
    },
    "@keyframes ns-sheet-up": {
      "from": {
        "transform": "translateY(100%)"
      }
    },
    "@keyframes ns-toast-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(10px)"
      }
    },
    "@keyframes ns-born": {
      "from": {
        "box-shadow": "0 0 0 2px var(--ns-signal), 0 0 0 8px color-mix(in oklab, var(--ns-signal) 22%, transparent)"
      }
    },
    "@keyframes ns-nudge": {
      "20%": {
        "translate": "-6px 0"
      },
      "45%": {
        "translate": "5px 0"
      },
      "70%": {
        "translate": "-3px 0"
      }
    },
    "@keyframes ns-pop": {
      "40%": {
        "scale": "1.15"
      }
    },
    "@keyframes ns-sheet-down": {
      "to": {
        "transform": "translateY(100%)"
      }
    },
    "@keyframes ns-spin": {
      "to": {
        "transform": "rotate(360deg)"
      }
    },
    "@keyframes ns-notch-turn": {
      "0%": {
        "rotate": "0deg",
        "scale": "1"
      },
      "25%": {
        "scale": "0.78"
      },
      "50%, 100%": {
        "rotate": "90deg",
        "scale": "1"
      }
    },
    "@keyframes ns-notch-a": {
      "0%": {
        "scale": "1",
        "opacity": "1"
      },
      "50%, 100%": {
        "scale": "0.55",
        "opacity": "0.45"
      }
    },
    "@keyframes ns-notch-b": {
      "0%": {
        "scale": "0.55",
        "opacity": "0.45"
      },
      "50%, 100%": {
        "scale": "1",
        "opacity": "1"
      }
    },
    "@keyframes ns-shimmer": {
      "to": {
        "background-position": "-200% 0"
      }
    },
    "@keyframes ns-live-pulse": {
      "from": {
        "box-shadow": "0 0 0 0 color-mix(in oklab, var(--ns-ok) 55%, transparent)"
      },
      "to": {
        "box-shadow": "0 0 0 9px transparent"
      }
    },
    "@keyframes ns-tick-draw": {
      "from": {
        "stroke-dashoffset": "1"
      }
    },
    "@keyframes ns-ink-draw": {
      "from": {
        "stroke-dashoffset": "1"
      }
    },
    "@keyframes ns-orb-turn": {
      "to": {
        "rotate": "360deg"
      }
    },
    "@keyframes ns-orb-breathe": {
      "50%": {
        "scale": "1.015"
      }
    },
    "@keyframes ns-orb-notch": {
      "0%": {
        "rotate": "0deg",
        "scale": "1"
      },
      "22%": {
        "scale": "0.86"
      },
      "45%, 100%": {
        "rotate": "90deg",
        "scale": "1"
      }
    },
    "@keyframes ns-orb-swell": {
      "50%": {
        "scale": "1.035"
      }
    },
    "@keyframes ns-orb-pulse": {
      "from": {
        "opacity": "0.85",
        "scale": "1"
      },
      "to": {
        "opacity": "0",
        "scale": "1.28"
      }
    },
    "@keyframes ns-orb-lean": {
      "50%": {
        "translate": "0 3%"
      }
    },
    "@keyframes ns-mark-fade": {
      "from": {
        "background-color": "color-mix(in oklab, var(--ns-signal) 22%, transparent)"
      },
      "to": {
        "background-color": "color-mix(in oklab, var(--ns-signal) 0%, transparent)"
      }
    },
    "@keyframes ns-word-in": {
      "from": {
        "opacity": "0.25"
      }
    },
    "[data-ns-fill]": {
      "background-color": "var(--ns-fill)",
      "background-image": "linear-gradient(to left, transparent, color-mix(in oklab, var(--ns-panel) 40%, transparent))",
      "transition": "box-shadow 150ms var(--ns-ease)"
    },
    "[data-ns-veil]": {
      "background-image": "linear-gradient(to left, transparent, color-mix(in oklab, var(--ns-panel) 40%, transparent))"
    },
    "[data-ns-fill=\"column\"], [data-ns-veil=\"column\"]": {
      "background-image": "linear-gradient(to bottom, transparent, color-mix(in oklab, var(--ns-panel) 40%, transparent))"
    },
    ":is([data-ns-glow-host]:hover, [data-ns-glow-host]:focus-visible) [data-ns-fill=\"\"], [data-ns-fill][data-ns-focus]": {
      "box-shadow": "0 0 10px 1px color-mix(in oklab, var(--ns-fill) var(--ns-glow), transparent)"
    },
    "@keyframes ns-glow-pulse": {
      "from": {
        "box-shadow": "0 0 0 0 color-mix(in oklab, var(--ns-pulse) calc(var(--ns-glow) + 20%), transparent)"
      },
      "to": {
        "box-shadow": "0 0 6px 8px transparent"
      }
    },
    ":root[data-motion=\"reduced\"] [data-ns-moves]": {
      "animation-name": "ns-fade !important"
    },
    ":root[data-motion=\"reduced\"] :is([data-ns-still], [data-ns-still] *)": {
      "animation": "none !important"
    },
    ":root[data-motion=\"reduced\"] [data-ns-glide]": {
      "transition": "none !important"
    },
    ":root[data-motion=\"reduced\"] [data-ns-stagger] > *": {
      "animation-name": "ns-fade !important",
      "animation-delay": "0s !important"
    },
    ".ns-notrans, .ns-notrans *": {
      "transition": "none !important"
    },
    ":focus-visible": {
      "--tw-outline-style": "solid"
    },
    "@keyframes ns-refuse": {
      "from": {
        "box-shadow": "0 0 0 1.5px var(--ns-bad), 0 0 0 6px color-mix(in oklab, var(--ns-bad) 20%, transparent)"
      }
    },
    "[data-ns-landed]": {
      "animation": "ns-born var(--ns-time-born) var(--ns-ease)"
    },
    "[data-ns-refused]": {
      "animation": "ns-nudge 360ms var(--ns-ease), ns-refuse 900ms var(--ns-ease)"
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":root [data-ns-moves]": {
        "animation-name": "ns-fade !important"
      },
      ":root :is([data-ns-still], [data-ns-still] *)": {
        "animation": "none !important"
      },
      ":root [data-ns-glide]": {
        "transition": "none !important"
      },
      ":root [data-ns-stagger] > *": {
        "animation-name": "ns-fade !important",
        "animation-delay": "0s !important"
      },
      ":root [data-ns-refused]": {
        "animation": "ns-refuse 900ms var(--ns-ease)"
      }
    },
    ":root[data-motion=\"reduced\"] [data-ns-refused]": {
      "animation": "ns-refuse 900ms var(--ns-ease)"
    },
    "@keyframes ns-drain": {
      "from": {
        "scale": "1 1"
      },
      "to": {
        "scale": "0 1"
      }
    },
    "@keyframes ns-sweep": {
      "from": {
        "scale": "0 1"
      }
    }
  },
  "files": [],
  "meta": {
    "tier": "free",
    "kind": "foundation",
    "source": "system"
  }
}
