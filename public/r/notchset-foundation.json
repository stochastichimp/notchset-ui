{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "notchset-foundation",
  "type": "registry:item",
  "title": "Notchset foundation",
  "description": "Notchset's shared CSS: tokens (light at :root, dark on .dark) reading your shadcn theme with Notchset's values as fallbacks, keyframes and the motion levels. Installed once, by any Notchset component.",
  "css": {
    "@keyframes ns-spin": {
      "to": {
        "transform": "rotate(360deg)"
      }
    },
    "@keyframes ns-arrow-in": {
      "from": {
        "transform": "translateX(-14px)",
        "opacity": "0"
      },
      "to": {
        "transform": "none",
        "opacity": "1"
      }
    },
    "@keyframes ns-shake": {
      "0%,100%": {
        "transform": "translateX(0)"
      },
      "18%": {
        "transform": "translateX(-7px)"
      },
      "36%": {
        "transform": "translateX(6px)"
      },
      "54%": {
        "transform": "translateX(-4px)"
      },
      "72%": {
        "transform": "translateX(2px)"
      }
    },
    "@keyframes ns-shake-b": {
      "0%,100%": {
        "transform": "translateX(0)"
      },
      "18%": {
        "transform": "translateX(-7px)"
      },
      "36%": {
        "transform": "translateX(6px)"
      },
      "54%": {
        "transform": "translateX(-4px)"
      },
      "72%": {
        "transform": "translateX(2px)"
      }
    },
    "@keyframes ns-sweep-out": {
      "from": {
        "opacity": "1",
        "transform": "none"
      },
      "to": {
        "opacity": "0",
        "transform": "translateX(-12px)"
      }
    },
    "@keyframes ns-launch": {
      "0%": {
        "transform": "none",
        "opacity": "1",
        "animation-timing-function": "cubic-bezier(.6,0,.9,.5)"
      },
      "36%": {
        "transform": "translateY(-16px)",
        "opacity": "0"
      },
      "37%": {
        "transform": "translateY(16px)",
        "opacity": "0",
        "animation-timing-function": "cubic-bezier(.2,1.5,.4,1)"
      },
      "100%": {
        "transform": "none",
        "opacity": "1"
      }
    },
    "@keyframes ns-code-sweep": {
      "0%": {
        "width": "0",
        "opacity": "1"
      },
      "45%": {
        "width": "100%",
        "opacity": "1"
      },
      "100%": {
        "width": "100%",
        "opacity": "0"
      }
    },
    "@keyframes ns-eq": {
      "0%,100%": {
        "transform": "scaleY(.3)"
      },
      "50%": {
        "transform": "scaleY(1)"
      }
    },
    "@keyframes ns-live": {
      "0%": {
        "transform": "scale(1)",
        "opacity": ".6"
      },
      "100%": {
        "transform": "scale(2.6)",
        "opacity": "0"
      }
    },
    "@keyframes ns-squish": {
      "0%": {
        "transform": "scale(1)"
      },
      "20%": {
        "transform": "scale(1.3,.7)"
      },
      "45%": {
        "transform": "scale(.84,1.2)"
      },
      "70%": {
        "transform": "scale(1.08,.94)"
      },
      "100%": {
        "transform": "scale(1)"
      }
    },
    "@keyframes ns-deflate": {
      "0%": {
        "transform": "scale(1)"
      },
      "40%": {
        "transform": "scale(.8)"
      },
      "100%": {
        "transform": "scale(1)"
      }
    },
    "@keyframes ns-float": {
      "0%": {
        "transform": "translate(0,4px) rotate(0) scale(.3)",
        "opacity": "0"
      },
      "25%": {
        "opacity": "1"
      },
      "100%": {
        "transform": "translate(0,-28px) rotate(var(--r)) scale(1)",
        "opacity": "0"
      }
    },
    "@keyframes ns-ribbon": {
      "0%": {
        "transform": "translateY(-8px) scaleY(.4)"
      },
      "55%": {
        "transform": "translateY(1px) scaleY(1.15)"
      },
      "80%": {
        "transform": "scaleY(.95)"
      },
      "100%": {
        "transform": "none"
      }
    },
    "@keyframes ns-march": {
      "to": {
        "background-position": "6px 0"
      }
    },
    "@keyframes ns-shimmer": {
      "from": {
        "background-position": "100% 0"
      },
      "to": {
        "background-position": "-100% 0"
      }
    },
    "@keyframes ns-blink": {
      "50%": {
        "opacity": "0"
      }
    },
    "@keyframes ns-twinkle": {
      "0%,100%": {
        "transform": "scale(1) rotate(0)"
      },
      "50%": {
        "transform": "scale(.75) rotate(25deg)"
      }
    },
    "@keyframes ns-fade-up": {
      "from": {
        "opacity": "0",
        "transform": "translateY(4px)"
      },
      "to": {
        "opacity": "1",
        "transform": "none"
      }
    },
    "@keyframes ns-sweep": {
      "from": {
        "transform": "translateX(-100%)"
      },
      "to": {
        "transform": "translateX(100%)"
      }
    },
    "@keyframes ns-bell": {
      "0%,100%": {
        "transform": "rotate(0)"
      },
      "15%": {
        "transform": "rotate(18deg)"
      },
      "30%": {
        "transform": "rotate(-15deg)"
      },
      "45%": {
        "transform": "rotate(10deg)"
      },
      "60%": {
        "transform": "rotate(-6deg)"
      },
      "75%": {
        "transform": "rotate(3deg)"
      }
    },
    "@keyframes ns-mic-ring": {
      "0%": {
        "transform": "scale(1)",
        "opacity": ".55"
      },
      "100%": {
        "transform": "scale(1.4)",
        "opacity": "0"
      }
    },
    "@keyframes ns-drawl": {
      "from": {
        "stroke-dashoffset": "1"
      },
      "to": {
        "stroke-dashoffset": "0"
      }
    },
    "@keyframes ns-growy": {
      "from": {
        "transform": "scaleY(0)"
      },
      "to": {
        "transform": "scaleY(1)"
      }
    },
    "@keyframes ns-slidex": {
      "from": {
        "transform": "translateX(-7px)",
        "opacity": "0"
      },
      "to": {
        "transform": "none",
        "opacity": "1"
      }
    },
    "@keyframes ns-num-in": {
      "from": {
        "width": "0",
        "opacity": "0"
      },
      "to": {
        "width": "1ch",
        "opacity": "1"
      }
    },
    "@keyframes ns-num-out": {
      "from": {
        "width": "1ch",
        "opacity": "1"
      },
      "to": {
        "width": "0",
        "opacity": "0"
      }
    },
    "@keyframes ns-num-blur": {
      "0%, 30%": {
        "filter": "blur(1.4px)"
      },
      "100%": {
        "filter": "none"
      }
    },
    "@keyframes ns-num-blur-b": {
      "0%, 30%": {
        "filter": "blur(1.4px)"
      },
      "100%": {
        "filter": "none"
      }
    },
    "@keyframes ns-bar-load": {
      "from": {
        "width": "0"
      },
      "to": {
        "width": "92%"
      }
    },
    "@keyframes ns-bar-drain": {
      "from": {
        "width": "100%"
      },
      "to": {
        "width": "0"
      }
    },
    "@keyframes ns-toast": {
      "from": {
        "opacity": "0",
        "transform": "translateY(24px) scale(.96)"
      }
    },
    "@keyframes ns-draw-x": {
      "from": {
        "clip-path": "inset(0 100% 0 0)"
      },
      "to": {
        "clip-path": "inset(0 0 0 0)"
      }
    },
    "@keyframes ns-float-b": {
      "0%": {
        "transform": "translate(0,4px) rotate(0) scale(.3)",
        "opacity": "0"
      },
      "25%": {
        "opacity": "1"
      },
      "100%": {
        "transform": "translate(0,-28px) rotate(var(--r)) scale(1)",
        "opacity": "0"
      }
    },
    "@keyframes ns-squish-b": {
      "0%": {
        "transform": "scale(1)"
      },
      "20%": {
        "transform": "scale(1.3,.7)"
      },
      "45%": {
        "transform": "scale(.84,1.2)"
      },
      "70%": {
        "transform": "scale(1.08,.94)"
      },
      "100%": {
        "transform": "scale(1)"
      }
    },
    "@keyframes ns-slide-l": {
      "from": {
        "opacity": "0",
        "transform": "translateX(24px)"
      },
      "to": {
        "opacity": "1",
        "transform": "none"
      }
    },
    "@keyframes ns-slide-r": {
      "from": {
        "opacity": "0",
        "transform": "translateX(-24px)"
      },
      "to": {
        "opacity": "1",
        "transform": "none"
      }
    },
    "@keyframes ns-word": {
      "from": {
        "opacity": "0",
        "filter": "blur(4px)",
        "transform": "translateY(3px)"
      },
      "to": {
        "opacity": "1",
        "filter": "none",
        "transform": "none"
      }
    },
    "@keyframes ns-rec": {
      "0%,100%": {
        "opacity": "1"
      },
      "50%": {
        "opacity": ".25"
      }
    },
    "@keyframes ns-chip": {
      "from": {
        "transform": "scale(.5)",
        "opacity": "0"
      },
      "to": {
        "transform": "none",
        "opacity": "1"
      }
    },
    "@keyframes ns-digit": {
      "from": {
        "transform": "translateY(8px) scale(.7)",
        "opacity": "0"
      },
      "to": {
        "transform": "none",
        "opacity": "1"
      }
    },
    "@keyframes ns-wave": {
      "0%,100%": {
        "transform": "translateY(0)"
      },
      "50%": {
        "transform": "translateY(-5px)"
      }
    },
    "@keyframes ns-bubble": {
      "from": {
        "opacity": "0",
        "transform": "translateY(12px) scale(.96)"
      },
      "to": {
        "opacity": "1",
        "transform": "none"
      }
    },
    "@keyframes ns-pulse": {
      "0%,100%": {
        "opacity": "1"
      },
      "50%": {
        "opacity": ".35"
      }
    },
    "@keyframes ns-comet": {
      "from": {
        "transform": "translateX(-100%)"
      },
      "to": {
        "transform": "translateX(320%)"
      }
    },
    "@keyframes ns-bump": {
      "0%": {
        "transform": "scale(1)"
      },
      "35%": {
        "transform": "scale(.93)"
      },
      "70%": {
        "transform": "scale(1.03)"
      },
      "100%": {
        "transform": "scale(1)"
      }
    },
    "@keyframes ns-skel": {
      "0%,100%": {
        "opacity": ".45"
      },
      "50%": {
        "opacity": "1"
      }
    },
    "@keyframes ns-reveal": {
      "from": {
        "opacity": "0",
        "filter": "blur(4px)",
        "transform": "translateY(4px)"
      },
      "to": {
        "opacity": "1",
        "filter": "none",
        "transform": "none"
      }
    },
    "@keyframes ns-dash": {
      "0%": {
        "stroke-dasharray": "1 60",
        "stroke-dashoffset": "0"
      },
      "50%": {
        "stroke-dasharray": "38 60",
        "stroke-dashoffset": "-10"
      },
      "100%": {
        "stroke-dasharray": "1 60",
        "stroke-dashoffset": "-56"
      }
    },
    "@keyframes ns-halo": {
      "0%": {
        "transform": "scale(.7)",
        "opacity": ".5"
      },
      "100%": {
        "transform": "scale(1.5)",
        "opacity": "0"
      }
    },
    "@keyframes ns-cell-wave": {
      "0%,100%": {
        "transform": "scaleY(1)"
      },
      "40%": {
        "transform": "scaleY(1.35)"
      }
    },
    "@keyframes ns-ribbon-up": {
      "from": {
        "transform": "scaleY(.85)"
      },
      "to": {
        "transform": "none"
      }
    },
    "@keyframes ns-breathe": {
      "0%,100%": {
        "transform": "scale(1)"
      },
      "50%": {
        "transform": "scale(1.04)"
      }
    },
    "@keyframes ns-heart": {
      "0%": {
        "transform": "scale(0)",
        "opacity": "0"
      },
      "15%": {
        "transform": "scale(1.25)",
        "opacity": "1"
      },
      "30%": {
        "transform": "scale(.95)"
      },
      "45%,80%": {
        "transform": "scale(1)",
        "opacity": "1"
      },
      "100%": {
        "transform": "scale(1.1) translateY(-20px)",
        "opacity": "0"
      }
    },
    "@keyframes ns-flash": {
      "from": {
        "background-color": "var(--accent)"
      },
      "to": {
        "background-color": "transparent"
      }
    },
    "@keyframes ns-bounce": {
      "0%,80%,100%": {
        "transform": "translateY(0)"
      },
      "40%": {
        "transform": "translateY(-10px)"
      }
    },
    "@keyframes ns-fresh": {
      "0%": {
        "background-color": "color-mix(in oklab, var(--chart-1) 12%, transparent)"
      },
      "100%": {
        "background-color": "transparent"
      }
    },
    "@keyframes ns-roll-up": {
      "from": {
        "transform": "translateY(0)"
      },
      "to": {
        "transform": "translateY(-50%)"
      }
    },
    "@keyframes ns-menu-fade": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes ns-menu-pop": {
      "from": {
        "transform": "scale(.94) translateY(-6px)"
      },
      "to": {
        "transform": "none"
      }
    },
    "@keyframes ns-menu-item": {
      "from": {
        "opacity": "0",
        "transform": "translateY(-6px)"
      },
      "to": {
        "opacity": "1",
        "transform": "none"
      }
    },
    "[data-notchset-chart]": {
      "--c1": "oklch(from var(--chart-1) l calc(c * 0.88) h)",
      "--c2": "oklch(from var(--chart-2) l calc(c * 0.88) h)",
      "--c3": "oklch(from var(--chart-3) l calc(c * 0.88) h)",
      "--c4": "oklch(from var(--chart-4) l calc(c * 0.88) h)",
      "--c5": "oklch(from var(--chart-5) l calc(c * 0.88) h)"
    },
    ":where(:root)": {
      "--ns-control-compact": "32px",
      "--ns-control-regular": "40px",
      "--ns-control-roomy": "48px",
      "--ns-control-field": "44px",
      "--ns-cta-height": "46px",
      "--ns-row-height": "52px",
      "--ns-inset-compact": "12px",
      "--ns-inset-regular": "18px",
      "--ns-inset-roomy": "24px",
      "--ns-type-note": "12px",
      "--ns-type-label": "13px",
      "--ns-type-copy": "14px",
      "--ns-leading-note": "16px",
      "--ns-leading-prose": "1.5",
      "--ns-tracking-control": "-0.01em",
      "--ns-shadow-layer": "0 18px 40px -16px rgba(0,0,0,.28), 0 2px 6px -2px rgba(0,0,0,.08)",
      "--ns-ease-press": "cubic-bezier(.3,.7,.4,1.6)",
      "--ns-ease-settle": "cubic-bezier(.2,1,.3,1)",
      "--ns-ease-reshape": "cubic-bezier(.2,1.3,.3,1)",
      "--ns-ease-pop": "cubic-bezier(.2,1.5,.4,1)",
      "--ns-ease-rebound": "cubic-bezier(.2,1.6,.4,1)",
      "--ns-time-press": "180ms",
      "--ns-time-response": "200ms",
      "--ns-time-color": "250ms",
      "--ns-time-state": "300ms",
      "--ns-time-reflow": "450ms",
      "--ns-press-depth": ".96"
    },
    ":where(:root, .light, [data-theme=\"light\"], [data-mode=\"light\"])": {
      "--ns-tint-panel": "14%",
      "--ns-tint-card": "17%",
      "--ns-tint-band": "4%",
      "--ns-tint-band-strong": "8%"
    },
    ":where(.dark, [data-theme=\"dark\"], [data-mode=\"dark\"])": {
      "--ns-tint-panel": "20%",
      "--ns-tint-card": "24%",
      "--ns-tint-band": "6%",
      "--ns-tint-band-strong": "12%"
    },
    "[data-motion=\"off\"] [data-notchset], [data-motion=\"off\"] [data-notchset] *, [data-motion=\"off\"] [data-notchset]::before, [data-motion=\"off\"] [data-notchset]::after, [data-motion=\"off\"] [data-notchset] *::before, [data-motion=\"off\"] [data-notchset] *::after, [data-notchset][data-motion=\"off\"], [data-notchset][data-motion=\"off\"] *, [data-notchset][data-motion=\"off\"]::before, [data-notchset][data-motion=\"off\"]::after, [data-notchset][data-motion=\"off\"] *::before, [data-notchset][data-motion=\"off\"] *::after": {
      "transition-duration": "0s !important",
      "transition-delay": "0s !important",
      "animation-duration": "0s !important",
      "animation-delay": "0s !important",
      "animation-iteration-count": "1 !important"
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":root [data-notchset],:root [data-notchset] *,:root [data-notchset]::before,:root [data-notchset]::after,:root [data-notchset] *::before,:root [data-notchset] *::after": {
        "transition-duration": "0s !important",
        "transition-delay": "0s !important",
        "animation-duration": "0s !important",
        "animation-delay": "0s !important",
        "animation-iteration-count": "1 !important"
      }
    },
    "@keyframes ns-dialog-in": {
      "from": {
        "opacity": "0",
        "transform": "translateY(16px) scale(.94)"
      }
    },
    "@keyframes ns-ring-down": {
      "from": {
        "stroke-dashoffset": "0"
      },
      "to": {
        "stroke-dashoffset": "1"
      }
    },
    "@keyframes ns-march-path": {
      "to": {
        "stroke-dashoffset": "-1"
      }
    },
    "@keyframes ns-fall": {
      "0%": {
        "transform": "translateY(-14px)",
        "opacity": "0"
      },
      "35%, 70%": {
        "transform": "none",
        "opacity": "1"
      },
      "100%": {
        "transform": "translateY(14px)",
        "opacity": "0"
      }
    },
    "@keyframes ns-ring": {
      "from": {
        "transform": "scale(1)",
        "opacity": ".55"
      },
      "to": {
        "transform": "scale(1.9)",
        "opacity": "0"
      }
    },
    "@keyframes ns-burst": {
      "from": {
        "transform": "rotate(var(--a)) translateX(0) scale(1)",
        "opacity": "1"
      },
      "to": {
        "transform": "rotate(var(--a)) translateX(28px) scale(0)",
        "opacity": "0"
      }
    },
    "@keyframes ns-grow-x": {
      "from": {
        "max-width": "0",
        "opacity": "0"
      },
      "to": {
        "max-width": "260px",
        "opacity": "1"
      }
    },
    "@keyframes ns-halo-dot": {
      "from": {
        "box-shadow": "0 0 0 3px var(--background), 0 0 0 3px color-mix(in oklab, var(--info, var(--chart-1)) 55%, transparent)"
      },
      "to": {
        "box-shadow": "0 0 0 3px var(--background), 0 0 0 12px transparent"
      }
    },
    "@keyframes ns-heart-pop": {
      "0%": {
        "transform": "scale(1)"
      },
      "30%": {
        "transform": "scale(.7)"
      },
      "60%": {
        "transform": "scale(1.28)"
      },
      "100%": {
        "transform": "scale(1)"
      }
    },
    "@keyframes ns-ring-burst": {
      "from": {
        "transform": "scale(.3)",
        "opacity": ".9"
      },
      "to": {
        "transform": "scale(1.7)",
        "opacity": "0"
      }
    },
    "@keyframes ns-part": {
      "from": {
        "transform": "translateY(0) scale(1)",
        "opacity": "1"
      },
      "to": {
        "transform": "translateY(-17px) scale(.2)",
        "opacity": "0"
      }
    },
    "@keyframes ns-drop-in": {
      "0%": {
        "transform": "translateY(-7px) scale(.8)"
      },
      "55%": {
        "transform": "translateY(1.5px) scale(1.06)"
      },
      "100%": {
        "transform": "none"
      }
    },
    "@keyframes ns-slide-from-right": {
      "from": {
        "opacity": "0",
        "transform": "translateX(16px)"
      }
    },
    "@keyframes ns-slide-from-left": {
      "from": {
        "opacity": "0",
        "transform": "translateX(-16px)"
      }
    },
    "@keyframes ns-fill-x": {
      "from": {
        "transform": "scaleX(0)"
      },
      "to": {
        "transform": "scaleX(1)"
      }
    },
    "@keyframes ns-shrink-x": {
      "from": {
        "transform": "scaleX(1)"
      },
      "to": {
        "transform": "scaleX(0)"
      }
    },
    "@keyframes ns-toast-rise": {
      "from": {
        "opacity": "0",
        "transform": "translateY(26px) scale(.9)"
      }
    },
    "@keyframes ns-glow": {
      "from": {
        "box-shadow": "0 0 0 0 color-mix(in oklab, var(--glow, var(--success,var(--foreground))) 45%, transparent)"
      },
      "to": {
        "box-shadow": "0 0 0 10px transparent"
      }
    },
    "@keyframes ns-glow-b": {
      "from": {
        "box-shadow": "0 0 0 0 color-mix(in oklab, var(--glow, var(--success,var(--foreground))) 45%, transparent)"
      },
      "to": {
        "box-shadow": "0 0 0 10px transparent"
      }
    },
    "@keyframes ns-bump-up": {
      "0%": {
        "transform": "scale(1)"
      },
      "40%": {
        "transform": "scale(1.18)"
      },
