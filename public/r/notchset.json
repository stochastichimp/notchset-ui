{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "notchset",
  "type": "registry:theme",
  "title": "Notchset theme",
  "description": "Notchset for shadcn/ui: shadcn's tokens in light and dark, the pill radius, and the optional --heart, --success, --info and --warning tokens; Geist and Geist Mono.",
  "registryDependencies": [
    "https://notchset.dev/r/notchset-font-sans.json",
    "https://notchset.dev/r/notchset-font-mono.json"
  ],
  "cssVars": {
    "light": {
      "background": "#fafafa",
      "foreground": "#0a0a0a",
      "card": "#ffffff",
      "muted": "#f4f4f5",
      "muted-foreground": "#71717a",
      "accent": "#f1f1f3",
      "border": "#e4e4e7",
      "input": "#e4e4e7",
      "primary": "#0a0a0a",
      "primary-foreground": "#fafafa",
      "secondary": "#f1f1f3",
      "secondary-foreground": "#0a0a0a",
      "destructive": "oklch(0.577 0.215 27.3)",
      "destructive-foreground": "#ffffff",
      "heart": "oklch(0.63 0.24 17)",
      "success": "oklch(0.6 0.15 150)",
      "success-foreground": "#ffffff",
      "info": "oklch(0.6 0.17 255)",
      "warning": "oklch(0.74 0.15 70)",
      "chart-1": "oklch(0.6 0.17 255)",
      "chart-2": "oklch(0.6 0.17 295)",
      "chart-3": "oklch(0.64 0.13 185)",
      "chart-4": "oklch(0.74 0.15 70)",
      "chart-5": "oklch(0.62 0.19 15)",
      "ring": "#a1a1aa",
      "radius": "999px"
    },
    "dark": {
      "background": "#09090b",
      "foreground": "#fafafa",
      "card": "#0e0e10",
      "muted": "#18181b",
      "muted-foreground": "#a1a1aa",
      "accent": "#1c1c1f",
      "border": "#232327",
      "input": "#2c2c31",
      "primary": "#fafafa",
      "primary-foreground": "#09090b",
      "secondary": "#1c1c1f",
      "secondary-foreground": "#fafafa",
      "destructive": "oklch(0.64 0.21 25)",
      "destructive-foreground": "#ffffff",
      "heart": "oklch(0.68 0.22 17)",
      "success": "oklch(0.72 0.16 150)",
      "success-foreground": "#06140b",
      "info": "oklch(0.7 0.15 255)",
      "warning": "oklch(0.8 0.14 70)",
      "chart-1": "oklch(0.7 0.15 255)",
      "chart-2": "oklch(0.7 0.15 295)",
      "chart-3": "oklch(0.74 0.12 185)",
      "chart-4": "oklch(0.8 0.14 70)",
      "chart-5": "oklch(0.7 0.17 15)",
      "ring": "#52525b"
    }
  },
  "css": {
    ":root[data-theme=\"dark\"], [data-theme=\"dark\"]": {
      "--background": "#09090b",
      "--foreground": "#fafafa",
      "--card": "#0e0e10",
      "--muted": "#18181b",
      "--muted-foreground": "#a1a1aa",
      "--accent": "#1c1c1f",
      "--border": "#232327",
      "--input": "#2c2c31",
      "--primary": "#fafafa",
      "--primary-foreground": "#09090b",
      "--secondary": "#1c1c1f",
      "--secondary-foreground": "#fafafa",
      "--destructive": "oklch(0.64 0.21 25)",
      "--destructive-foreground": "#ffffff",
      "--heart": "oklch(0.68 0.22 17)",
      "--success": "oklch(0.72 0.16 150)",
      "--success-foreground": "#06140b",
      "--info": "oklch(0.7 0.15 255)",
      "--warning": "oklch(0.8 0.14 70)",
      "--chart-1": "oklch(0.7 0.15 255)",
      "--chart-2": "oklch(0.7 0.15 295)",
      "--chart-3": "oklch(0.74 0.12 185)",
      "--chart-4": "oklch(0.8 0.14 70)",
      "--chart-5": "oklch(0.7 0.17 15)",
      "--ring": "#52525b"
    },
    "[data-notchset-recolor]": {},
    ":where(.dark, [data-theme=\"dark\"]) [data-notchset-recolor]": {}
  },
  "docs": "Notchset theme installed. Theming: https://notchset.dev/docs/theming",
  "meta": {
    "tier": "free",
    "kind": "theme",
    "theme": "notchset"
  }
}
