{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "notchset-font-sans",
  "type": "registry:font",
  "title": "Notchset sans font (Geist)",
  "description": "Geist from Google Fonts as --font-sans.",
  "font": {
    "family": "Geist",
    "provider": "google",
    "import": "Geist",
    "variable": "--font-sans",
    "subsets": [
      "latin"
    ],
    "dependency": "@fontsource-variable/geist"
  },
  "meta": {
    "tier": "free",
    "kind": "font",
    "theme": "notchset"
  }
}
